+			triangles[count++] = verts[b];
+			triangles[count++] = verts[i];
+			if (count == ARRLEN(triangles) || i == numVerts - 1)
+			{
+				GL3_BufferAndDraw3D(triangles, count, GL_TRIANGLES);
+				count = 0;
+			}
