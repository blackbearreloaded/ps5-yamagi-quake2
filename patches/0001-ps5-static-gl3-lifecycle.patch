+#ifdef YQ2_PS5
+/* Keep consecutive font glyphs in one draw; flush before other rendering. */
+static GLfloat charVertices[1024 * 6 * 4];
+static unsigned charVertexCount;
+
+void GL3_FlushChars(void)
+{
+	if (!charVertexCount) return;
+	GL3_UseProgram(gl3state.si2D.shaderProgram);
+	GL3_Bind(draw_chars->texnum);
+	GL3_BindVAO(vao2D);
+	GL3_BindVBO(vbo2D);
+	glBufferData(GL_ARRAY_BUFFER, charVertexCount * 4 * sizeof(GLfloat), charVertices, GL_STREAM_DRAW);
+	glDrawArrays(GL_TRIANGLES, 0, charVertexCount);
+	charVertexCount = 0;
+}
+
+static void appendChar(float x, float y, float size, float s, float t)
+{
+	if (charVertexCount == 1024 * 6) GL3_FlushChars();
+	const GLfloat vertices[6][4] = {
+		{x, y+size, s, t+0.0625f}, {x, y, s, t}, {x+size, y+size, s+0.0625f, t+0.0625f},
+		{x+size, y+size, s+0.0625f, t+0.0625f}, {x, y, s, t}, {x+size, y, s+0.0625f, t}
+	};
+	memcpy(charVertices + charVertexCount * 4, vertices, sizeof(vertices));
+	charVertexCount += 6;
+}
+#endif
