+
+static int
+CompareSurfaceMaterial(const void *left, const void *right)
+{
+	const ps5_surface_sort_t *a = left, *b = right;
+	if (a->texture != b->texture)
+		return a->texture < b->texture ? -1 : 1;
+	if (a->surface->lightmaptexturenum != b->surface->lightmaptexturenum)
+		return a->surface->lightmaptexturenum < b->surface->lightmaptexturenum ? -1 : 1;
+	int styles = memcmp(a->surface->styles, b->surface->styles, sizeof(a->surface->styles));
+	if (styles)
+		return styles;
+	return a->order < b->order ? -1 : a->order > b->order;
+}
+
+static void
+SortTextureChain(entity_t *entity, msurface_t **chain)
+{
+	ps5_surface_sort_t entries[1024];
+	while (*chain)
+	{
+		if (!BatchableSurface(*chain))
+		{
+			chain = &(*chain)->texturechain;
+			continue;
+		}
+		msurface_t *next = *chain;
+		unsigned count = 0;
+		while (next && count < ARRLEN(entries) && BatchableSurface(next))
+		{
+			entries[count] = (ps5_surface_sort_t){next,
+				R_TextureAnimation(entity, next->texinfo)->texnum, count};
+			++count;
+			next = next->texturechain;
+		}
+		qsort(entries, count, sizeof(entries[0]), CompareSurfaceMaterial);
+		*chain = entries[0].surface;
+		for (unsigned i = 1; i < count; ++i)
+			entries[i - 1].surface->texturechain = entries[i].surface;
+		entries[count - 1].surface->texturechain = next;
+		chain = &entries[count - 1].surface->texturechain;
+	}
