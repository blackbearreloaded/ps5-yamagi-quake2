+static qboolean
+BatchableSurface(const msurface_t *s)
+{
+	return !(s->flags & SURF_DRAWTURB) &&
+	       !(s->texinfo->flags & (SURF_FLOWING | SURF_TRANS33 | SURF_TRANS66 | SURF_SKY | SURF_WARP));
