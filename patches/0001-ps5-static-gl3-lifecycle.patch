@@ -648,6 +671,26 @@ Sys_RemoveDir(const char *path)
 qboolean
 Sys_Realpath(const char *in, char *out, size_t size)
 {
+#ifdef YQ2_PS5
+	/* Native realpath is denied by the title sandbox. These are the only
+	 * search roots supplied by the native entry, already absolute and fixed. */
+	static const char *roots[] = { "/download0/yamagi", "/app0", "/app0/assets" };
+	size_t length = strlen(in);
+	while (length > 1 && in[length - 1] == '/') --length;
+	for (size_t i = 0; i < sizeof(roots) / sizeof(roots[0]); ++i)
+	{
+		if (strlen(roots[i]) == length && !strncmp(in, roots[i], length))
+		{
+			struct stat info;
+			if (length >= size || stat(roots[i], &info) != 0 || !S_ISDIR(info.st_mode))
+				return false;
+			Q_strlcpy(out, roots[i], size);
+			return true;
+		}
+	}
+	Com_Printf("Unsupported native search root: %s\n", in);
+	return false;
+#else
 	char *converted = realpath(in, NULL);
 
 	if (converted == NULL)
@@ -660,6 +703,7 @@ Sys_Realpath(const char *in, char *out, size_t size)
 	free(converted);
 
 	return true;
+#endif
 }
 
