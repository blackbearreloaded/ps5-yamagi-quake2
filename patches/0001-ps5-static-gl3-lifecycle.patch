+	if (drawMode == GL_TRIANGLE_FAN || drawMode == GL_TRIANGLE_STRIP)
+	{
+		/* The native batch accepts triangle lists. Keep winding and every
+		 * vertex attribute; bounded chunks also cover unusually large faces. */
+		gl3_3D_vtx_t triangles[192];
+		int count = 0;
